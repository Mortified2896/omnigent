[Unit]
Description=Control Room peer-deployer (root-owned, O1<->O2 upgrade gate)
Documentation=file:/opt/control-room-peer-deployer/releases/current/docs/permanent-peer-deployer.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
# Run from the immutable release root so ``-m peer_deployer.service``
# resolves the package copied into the venv's site-packages dir.
WorkingDirectory=/opt/control-room-peer-deployer/releases/current
ExecStart=/opt/control-room-peer-deployer/releases/current/venv/bin/python -m peer_deployer.service --socket /run/control-room-peer-deployer/control.sock
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30
SuccessExitStatus=0

# Local IPC over Unix-domain socket.  We also need AF_INET/AF_INET6
# because the daemon probes O1 (127.0.0.1:4097) and O2 (127.0.0.1:4197)
# /health endpoints over loopback IPv4/IPv6.  The daemon does NOT bind
# a TCP listening socket of its own: an external check after install
# proves no TCP listener appears owned by this service.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Cannot escalate.  Cannot touch any state outside what is allow-listed.
NoNewPrivileges=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
SystemCallArchitectures=native

# Filesystem allow-list:
#   * /var/lib/control-room-peer-deployer — daemon state root (transactions,
#     evidence, locks, artifacts registry, plans).
#   * /run/control-room-peer-deployer — Unix socket + lock symlink.
#   * /opt/control-room-peer-deployer/releases — the immutable release tree;
#     promoted by the daemon on switch.
#   * /opt/control-room-peer-deployer/current — the symlink that the daemon
#     rotates atomically.
#   * /opt/omnigent + /opt/omnigent-production + /var/lib/omnigent +
#     /var/lib/omnigent-production — the two approved deployment roots
#     and state homes (paired runtime + DB writes during promotion).
#   * /var/log/journal — journald write access for our log entries.
ReadWritePaths=/var/lib/control-room-peer-deployer \
              /run/control-room-peer-deployer \
              /opt/control-room-peer-deployer/releases \
              /opt/control-room-peer-deployer/current \
              /opt/omnigent \
              /opt/omnigent-production \
              /var/lib/omnigent \
              /var/lib/omnigent-production \
              /var/log/journal
ReadOnlyPaths=/opt/control-room-peer-deployer/venv /etc/control-room-peer-deployer

# Capability bounding set: this service must read /proc/<pid>/cgroup
# for peer-identity binding, perform the symbolic-link + rename
# manipulations required for atomic runtime switches, and write
# approved deployment roots.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN CAP_KILL CAP_SETUID CAP_SETGID CAP_SYS_PTRACE
AmbientCapabilities=
PrivateUsers=false

# We deliberately retain CAP_SYS_PTRACE so the daemon can read
# /proc/<pid>/cgroup of the connecting client for peer-identity
# binding.  Everything else is denied.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap

# Logs only to the journal; no socket activation, no environment file.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=control-room-peer-deployer

# Restrict network exposure further.  Permit only loopback (::1, 127.0.0.0/8)
# via nftables-style address family filtering is not directly possible in the
# unit, but AddressFamilies allows loopback and our daemon never binds a TCP
# listener.  No external network is reachable without @system-service filter
# and without the kernel's loopback-only routing.

[Install]
WantedBy=multi-user.target
