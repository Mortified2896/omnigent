# ─────────────────────────────────────────────────────────────────────
# /etc/omnigent/env.conf — Omnigent 0.7 production EnvironmentFile
# ─────────────────────────────────────────────────────────────────────
#
# This file is sourced by the `omnigent.service` systemd unit via
# `EnvironmentFile=`. Every variable here becomes part of the
# service's process environment on every start.
#
# INSTALL / EDIT:
#   1. Copy to /etc/omnigent/env.conf on the production host.
#   2. Uncomment / set the variables that apply to your deploy.
#   3. Set file mode to 0640, owner root:omnigent (or whichever
#      group the systemd unit's User= resolves to):
#         sudo install -m 0640 -o root -g omnigent \
#             env.conf.template /etc/omnigent/env.conf
#         sudo systemctl daemon-reload
#
# WHAT LIVES HERE VS WHAT LIVES IN config.yaml:
#   - This file: secrets + env-only knobs (data dir, harness tmp
#     parent, OpenTelemetry exporter config, header auth, harness
#     binary paths).
#   - /var/lib/omnigent/config.yaml (the server config, not this
#     file): non-secret operator-editable settings (admins, allowed
#     domains, artifact_location, database_uri, copy_max_files,
#     policy_modules).
#   - ~/.omnigent/config.yaml (the user-level config): providers
#     block + routing block (LLM and OmniRoute providers, per-harness
#     model routing).
#
# WHAT THIS FILE AVOIDS:
#   - Variables upstream v0.7 no longer reads (e.g. the legacy
#     `OMNIGENT_HARNESS_TMP_PARENT` for non-tmp purposes, the
#     deprecated `HARNESS_*_PATH` knob — replaced by
#     `OMNIGENT_<NAME>_PATH` upstream).
#   - Hard-coded executable paths (the unit's ExecStart= resolves
#     the actual omni shim path at install time; see
#     deploy/rebuild/systemd/omnigent.service.template).

# ─── 1. Data dir (the persistent state root) ──────────────────────
# This is the directory the new wheel creates `<data_dir>/chat.db`
# in on first boot, and where it looks for `<data_dir>/config.yaml`,
# `<data_dir>/artifacts/`, `<data_dir>/local_server.{pid,sig,logpath}`,
# `<data_dir>/admins`, `<data_dir>/allowed_domains`.
#
# MUST exist and be writable by the systemd unit's User= before the
# first `systemctl start`.
OMNIGENT_DATA_DIR=/var/lib/omnigent

# ─── 2. Authentication (must match the reverse proxy) ────────────
# Header-auth mode: the server trusts a single identity header
# injected by an upstream proxy (oauth2-proxy, Cloudflare Access,
# Google IAP, Databricks Apps). The default header name is
# X-Forwarded-Email; Cloudflare Access deployments must override.
OMNIGENT_AUTH_PROVIDER=header
OMNIGENT_AUTH_HEADER=X-Forwarded-Email
# Cloudflare Access deployments: set this instead and comment out the
# line above:
# OMNIGENT_AUTH_HEADER=Cf-Access-Authenticated-User-Email

# Google IAP prefixes the identity with "accounts.google.com:" —
# strip it so the bare email lands in the auth principal:
# OMNIGENT_AUTH_HEADER_STRIP_PREFIX=accounts.google.com:

# Multi-user switch. The production deploy is multi-user; the local
# laptop install is single-user (OMNIGENT_AUTH_ENABLED unset). Set
# this explicitly so a typo on the unit file does not silently flip
# the server to single-user mode.
OMNIGENT_AUTH_ENABLED=1

# Where the admin roster lives. One identity per line; `#` starts a
# comment. mtime-cached; edit and the next login picks it up.
OMNIGENT_ADMIN_LIST_PATH=/etc/omnigent/admins

# Where the email-domain allowlist lives (header / OIDC modes).
# Optional; empty / absent means "no domain filter".
# OMNIGENT_ALLOWED_DOMAINS_PATH=/etc/omnigent/allowed_domains

# ─── 3. Telemetry / Langfuse (OpenTelemetry exporter) ─────────────
# Master opt-in. When unset/false, init() is a no-op, no spans are
# created, no instrumentor hooks fire — default-install users pay
# nothing. Read directly from the env (not cached) so it is correct
# regardless of which entry point runs first.
OMNIGENT_TELEMETRY_ENABLED=1
OMNIGENT_OTEL_CAPTURE_CONTENT=0

# Standard OTLP env vars. Langfuse exposes an OTLP-compatible
# endpoint at /api/public/otel; the Authorization header carries
# the public key.
OTEL_EXPORTER_OTLP_ENDPOINT=https://langfuse.example.com/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<langfuse-public-key>
OTEL_SERVICE_NAME=omnigent-prod

# ─── 4. Harness layout ────────────────────────────────────────────
# Where the runner stages per-session worktrees and harness tmp
# files. Created on demand by the runner; must be writable by the
# systemd unit's User= and large enough to hold concurrent worktrees.
OMNIGENT_HARNESS_TMP_PARENT=/srv/omnigent/harness-tmp

# Harness idle timeout. Sessions idle longer than this are reaped.
# Set to 0 to disable the reap entirely (the production deploy
# previously ran with this disabled; re-enable only if you're
# confident no long-running quiet session is expected).
OMNIGENT_HARNESS_IDLE_TIMEOUT_S=3600

# Per-harness binary overrides. Set each variable ONLY if the
# upstream PATH discovery does not find the binary at the expected
# name (e.g. installed under /usr/local/bin instead of /opt/<harness>).
# Each one is `<NAME>_PATH` (no `HARNESS_` prefix in upstream v0.7).
# OMNIGENT_PI_PATH=/usr/local/bin/pi
# OMNIGENT_OPENCODE_PATH=/usr/local/bin/opencode
# OMNIGENT_CLAUDE_PATH=/usr/local/bin/claude
# OMNIGENT_CODEX_PATH=/usr/local/bin/codex
# OMNIGENT_CURSOR_PATH=/usr/local/bin/cursor-agent
# OMNIGENT_HERMES_PATH=/usr/local/bin/hermes

# ─── 5. Index / package source ────────────────────────────────────
# Where `omni upgrade` looks for newer releases. Defaults to
# pypi.org/simple if unset. Set to a private index URL when the
# rebuild wheel is published to an internal mirror.
# OMNIGENT_INDEX_URL=https://pypi.org/simple

# ─── 6. Secrets ───────────────────────────────────────────────────
# These are sensitive; keep the file mode at 0640 with a tight group.
# OMNIGENT_RUNNER_TUNNEL_TOKEN=...
# OMNIROUTE_API_KEY=...